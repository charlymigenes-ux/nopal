# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Datos de usuario (no se versionan, se generan en cada instalación)
uploads/
previews/
backups/
database/
logs/
laser_registry.json
laser_history.json
marlin_printer_registry.json
elegoo_printer_registry.json
flashforge_printer_registry.json
bambu_printer_registry.json
camera_registry.json
temperature_presets.json
scheduled_prints.json
pricing_config.json
quotes_registry.json
accessory_registry.json
arduino_boards_config.json
auth_users.json
spoolman_config.json
spoolman_printer_links.json
spoolman_reservations.json
spoolman_usage_log.json
tunascreen_devices.json
*.corrupt-*.bak
.session_secret

# Credenciales reales de placas NOPAL (Wi-Fi/OTA) — usa secrets.h.example
# como plantilla, secrets.h con los datos reales nunca se sube. Glob (no
# ruta exacta) para cubrir también los secrets.h de cada subcarpeta de
# sketch (NOPAL_ESP12E_BUZZER/, NOPAL_NodeMCU_V3_ESP8266/, etc.).
firmware/nopal_accessory/**/secrets.h
firmware/nopal_accessory/secrets.h

# Binarios .bin subidos para flashear placas NOPAL — se suben desde el
# panel, no se versionan (pueden pesar varios MB y son específicos de cada
# instalación).
firmware/nopal_accessory/builds/

# Estado de instancia (instalaciones de plugins, logs de actividad, etc.)
# — no es código fuente, se genera en cada instalación.
data/

# Código de plugins clonado por git (ver plugin_installer_service.py) --
# cada plugin es su propio repo, NOPAL core solo guarda el catálogo curado
# (backend/plugin_catalog.json) y el estado de instalación (data/plugins/).
plugins/

# Respaldos automáticos de otras herramientas (Codex, etc.), no son parte
# del proyecto.
.codex-backups/

# Entorno / configuración local
.env
.claude/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
